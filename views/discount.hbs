<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<h1>{{title}}</h1>
<form action="/verify" method="POST">
    {{!-- radiobutton --}}
    <div class="form-check" style="text-align:center">
        <input class="form-check-input" type="radio" name="option" id="vc" value="vc" checked>
        <label class="form-check-label" for="vc">
            VCs
        </label>
        <input class="form-check-input" type="radio" name="option" id="vp" value="vp">
        <label class="form-check-label" for="vp">
            VPs
        </label>
    </div>
    <div id="reader" style="width: 100%;"></div>
    <input type="hidden" id="qrData" name="qrData" value="">

    <div class="text-right">
        <button id="submitBtn" type="submit" class="btn btn-success" disabled>Apply</button>
    </div>
</form>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="/js/html5-qrcode.min.js"></script>
    <script>
        const html5QrCode = new Html5Qrcode("reader");

        const config = { fps: 10, qrbox: 350 };
        const qrCodeSuccessCallback = (decodedText, decodedResult) => {
            const qrDataInput = document.getElementById('qrData');
            qrDataInput.value = decodedText;

            Toastify({
                text: "QR Code Scanned Successfully!",
                duration: 7000, 
                gravity: "top", 
                position: "center", 
                backgroundColor: "linear-gradient(to right, #00b09b, #96c93d)"
            }).showToast();

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = false;
            html5QrCode.pause().catch(err => console.error("Failed to pause scanning:", err));
            // html5QrCode.stop().catch(err => console.error("Failed to stop scanning:", err));
        };

        html5QrCode.start(
            { facingMode: "environment" }, 
            config,
            qrCodeSuccessCallback
        )
        .catch(err => console.error(`Error starting QR Code scanner: ${err}`));

    </script>