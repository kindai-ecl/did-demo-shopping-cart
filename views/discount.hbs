<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<h1>{{title}}</h1>
<form action="/verify" method="POST">
    {{!-- radiobutton --}}
    <div class="form-check" style="text-align:center">
        <input class="form-check-input" type="radio" name="option" id="vc" value="vc" checked>
        <label class="form-check-label" for="vc">
            VCs
        </label>
        <input class="form-check-input" type="radio" name="option" id="vp" value="vp">
        <label class="form-check-label" for="vp">
            VPs
        </label>
        <div class="text-center">
            <b>Preferred camera:</b>
            <select id="cam-list">
                <option value="environment" selected>Environment Facing (default)</option>
            </select>
        <button id="submitBtn" type="submit" class="btn btn-success" disabled>Apply</button>
        </div>
    </div>
    <div id="reader" style="width: 80%; margin: 0 auto; text-align: center; margin-top: 20px;">
        <input type="hidden" id="qrData" name="qrData" value="">
        <video id="qr-video"></video>
    </div>
</form>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    {{!-- <script src="camera.js"></script> --}}
<script type="module">
    import QrScanner from "./js/qr-scanner.min.js";

    const video = document.getElementById('qr-video');
    const camList = document.getElementById('cam-list');
    const submitBtn = document.getElementById('submitBtn');
    const qrDataInput = document.getElementById('qrData');

    const setResult = (result) => {
        qrDataInput.value = result.data;
        scanner.stop()

        Toastify({
                text: "QR Code Scanned Successfully!",
                duration: 7000, 
                gravity: "top", 
                position: "center", 
                backgroundColor: "linear-gradient(to right, #00b09b, #96c93d)"
            }).showToast();

        submitBtn.disabled = false;
    };

    const scanner = new QrScanner(video, result => setResult(result),
    {
        onDecodeError: error => {
        },
        highlightScanRegion: true,
        highlightCodeOutline: true,
    });

    const updateFlashAvailability = () => {
    };

    scanner.start().then(() => {
    updateFlashAvailability();
    QrScanner.listCameras(true).then(cameras => cameras.forEach(camera => {
        const option = document.createElement('option');
        option.value = camera.id;
        option.text = camera.label;
        camList.add(option);
    }));
    });

    await QrScanner.hasCamera().then(console.log("Camera available"));
    scanner.start().catch(err => console.error("Error starting scanner:", err));

</script>
